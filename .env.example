# ============================================================
# AI Teacher - Human-Like Adaptive AI Educator
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and configure your environment variables.
# DO NOT commit real secrets or credentials to version control.
# ============================================================

# Application Environment (development, production, testing)
APP_ENV=development
PROJECT_NAME="AI Teacher - Human-Like Adaptive AI Educator"
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api
LOG_LEVEL=INFO

# Demo & Integration Mode (Agent 10)
# When DEMO_MODE=true, canonical hackathon scenarios are enabled with deterministic reliability
DEMO_MODE=true
# When ENABLE_MOCK_PROVIDERS=true, fallback to zero-latency mock if external APIs are unavailable
ENABLE_MOCK_PROVIDERS=true
MAX_RETEACH_ATTEMPTS=2

# Large Language Model Provider (Agent 1, Agent 6, Agent 7)
# Supported: gemini, openai, local_ollama, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-3.7-flash

# Knowledge Retrieval & Vector Store (Agent 2 - RAG)
# Supported: in_memory_keyword, chroma, faiss
VECTOR_STORE=in_memory_keyword
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=models/text-embedding-004
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_FILE_SIZE_MB=50

# Voice / TTS Synthesis Engine (Agent 5)
# Supported: web_speech_api (browser-native zero-dependency), elevenlabs, mock
VOICE_PROVIDER=web_speech_api
VOICE_API_KEY=

# Avatar & Visual Engine (Agent 4 & Agent 5)
# Supported: svg_animated (high-fidelity live lip-synced SVG canvas), heygen, mock
AVATAR_PROVIDER=svg_animated
AVATAR_API_KEY=

# Personalization & Learner Model Storage (Agent 3)
DATABASE_URL=sqlite:///./backend/data/learner_profiles.db
